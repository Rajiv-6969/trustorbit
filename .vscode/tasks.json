{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run pipeline",
      "type": "shell",
      "command": "./mvnw -q exec:java -Dexec.args=run",
      "windows": { "command": ".\\mvnw.cmd -q exec:java -Dexec.args=run" },
      "options": { "cwd": "${workspaceFolder}/java" },
      "problemMatcher": []
    },
    {
      "label": "Test Java",
      "type": "shell",
      "command": "./mvnw verify",
      "windows": { "command": ".\\mvnw.cmd verify" },
      "options": { "cwd": "${workspaceFolder}/java" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Start website",
      "type": "shell",
      "command": "npm install && npm run dev",
      "options": { "cwd": "${workspaceFolder}/website" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
