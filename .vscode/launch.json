{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "TrustOrbit: run pipeline",
      "request": "launch",
      "mainClass": "com.trustorbit.Main",
      "projectName": "trustorbit",
      "cwd": "${workspaceFolder}/java",
      "args": "run"
    },
    {
      "type": "java",
      "name": "TrustOrbit: data summary",
      "request": "launch",
      "mainClass": "com.trustorbit.Main",
      "projectName": "trustorbit",
      "cwd": "${workspaceFolder}/java",
      "args": "summary"
    },
    {
      "type": "java",
      "name": "TrustOrbit: custom command…",
      "request": "launch",
      "mainClass": "com.trustorbit.Main",
      "projectName": "trustorbit",
      "cwd": "${workspaceFolder}/java",
      "args": "${input:command}"
    }
  ],
  "inputs": [
    {
      "id": "command",
      "type": "promptString",
      "description": "Command and arguments, e.g. search 2025-10-01 2025-11-30",
      "default": "help"
    }
  ]
}
