{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Debug TrustOrbit backend",
      "request": "launch",
      "mainClass": "com.trustorbit.TrustOrbitApplication",
      "projectName": "trustorbit-backend",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "chrome",
      "name": "Debug frontend (Chrome)",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ]
}
