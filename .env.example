# Copy to .env and fill in. NEVER commit .env.

# Database (docker compose sets these automatically for local use)
DATABASE_URL=jdbc:postgresql://localhost:5432/trustorbit
DATABASE_USER=trustorbit
DATABASE_PASSWORD=trustorbit

# NASA FIRMS active-fire API key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Optional - without it TrustOrbit uses the committed FIRMS sample.
FIRMS_MAP_KEY=

# Extra allowed front-end origins for CORS (comma-separated patterns)
TRUSTORBIT_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app,https://*.netlify.app
