<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.trustorbit</groupId>
  <artifactId>trustorbit</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>TrustOrbit</name>
  <description>AI-Based Space Intelligence &amp; Geospatial Data Reliability Management System</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <weka.version>3.8.7</weka.version>
    <netcdf.version>5.11.0</netcdf.version>
    <sqlite.version>3.53.4.0</sqlite.version>
    <openpdf.version>3.0.5</openpdf.version>
    <jackson.version>2.22.3</jackson.version>
    <junit.version>5.14.4</junit.version>
  </properties>

  <!-- NetCDF-Java (cdm-core) is published by Unidata, not Maven Central -->
  <repositories>
    <repository>
      <id>unidata-all</id>
      <name>Unidata</name>
      <url>https://artifacts.unidata.ucar.edu/repository/unidata-all/</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!-- M3: anomaly detection -->
    <dependency>
      <groupId>nz.ac.waikato.cms.weka</groupId>
      <artifactId>weka-stable</artifactId>
      <version>${weka.version}</version>
    </dependency>
    <!-- M1: read ISRO HDF5 / NetCDF files -->
    <dependency>
      <groupId>edu.ucar</groupId>
      <artifactId>cdm-core</artifactId>
      <version>${netcdf.version}</version>
    </dependency>
    <!-- Already shipped with cdm-core (runtime scope); its public API returns Guava lists,
         so the compiler needs to see it too. Not an extra library. -->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>33.7.1-jre</version>
    </dependency>
    <!-- M4: single-file database -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
    </dependency>
    <!-- M4: PDF reports -->
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>${openpdf.version}</version>
    </dependency>
    <!-- JSON (MOSDAC API responses, website exports) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
      </plugin>
      <!-- ./mvnw -q exec:java -Dexec.args="run" -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <mainClass>com.trustorbit.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
