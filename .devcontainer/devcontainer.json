{
  "name": "TrustOrbit (JDK 21 + Node)",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [5173],
  "portsAttributes": { "5173": { "label": "TrustOrbit website" } },
  "postCreateCommand": "cd java && ./mvnw -q -B dependency:go-offline && cd ../website && npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
